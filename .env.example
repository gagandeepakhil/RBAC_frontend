# Copy this file to .env and adjust as needed for local development.
# Create React App only exposes variables prefixed with REACT_APP_ to the browser bundle,
# and only picks them up at build/start time (restart `npm start` after changing this file).

# Base URL of the RBAC_backend API. Point this at your local backend while developing,
# e.g. http://localhost:5000. Falls back to the deployed backend if unset.
REACT_APP_API_URL=http://localhost:5000

# Base URL of the OTP-sending service used during signup.
REACT_APP_OTP_URL=https://mail-otp-sender.vercel.app/
